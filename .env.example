# =====================================================================
# AI CV OPTIMIZER CONFIGURATION (.env)
# Node.js + Express.js Engine
# =====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT_SECRET / SESSION_SECRET: Express security & authentication key
JWT_SECRET="cv-optimizer-jwt-secret-key-change-in-production"
SESSION_SECRET="cv-optimizer-session-secret-change-in-production"

# SERVER PORT (Fixed: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Optional - for remote Supabase persistence)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
